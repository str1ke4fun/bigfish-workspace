{
  "name": "dsh-bili",
  "version": "0.1.0",
  "description": "大肥鱼的 B 站面：刷站、出门会话、看画面、评论区说话。依赖宿主服务 fishCore，零依赖，不 import dsh-fish 内部文件。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "AGENTS.md"
  ],
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "bilibili"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
