# Local recovery evidence and private runtime state (never publish).
# Root-level notes are local by default; the project README is public.
/*.md
!/README.md
!/AGENTS.md
!/ARCHITECTURE.md
/payload/
/sandbox/
# Machine-specific installation, migration and diagnostic scripts stay local.
# Project ops tooling (watchdog + its systemd unit templates) ships with the repo.
/scripts/*
!/scripts/audit-staged.py
!/scripts/fish_watchdog.py
!/scripts/test_fish_watchdog.py
!/scripts/systemd/
!/scripts/ops/
/.tmp/
/logs/
/payload/house/
/payload/recovered/
/payload/zips/
/sd/
/offline/
/reports/
# Historical handoff notes include private conversations and account identifiers.
/payload/docs/
/交接单.md
/交接清单.md
/待排查清单.md
/离线安装记录-2026-11-01.md

# Credentials and machine-local configuration.
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
**/owner.json
**/policy.json
**/speech.json
**/.dsh/
**/.dsh-fish/
**/.dsh-wx/
**/.config/

# Dependencies, generated files and disk/archive images.
node_modules/
__pycache__/
*.py[cod]
*.log
*.bak
*.zip
*.tar
*.tar.gz
*.tgz
*.deb
*.img
*.vhdx
*.iso
.DS_Store
Thumbs.db
